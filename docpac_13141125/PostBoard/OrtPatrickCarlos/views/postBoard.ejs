<!DOCTYPE html>
<html>
<head>
    <title>Post Board</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
            line-height: 1.6;
        }

        h1, h2 {
            text-align: center;
            color: #007bff;
        }

        ul {
            list-style: none;
            padding: 0;
            margin: 2rem auto;
            max-width: 800px;
        }

        li {
            background: #fff;
            margin-bottom: 1.5rem;
            padding: 1.5rem;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        li h3 {
            margin: 0 0 0.5rem;
            font-size: 1.5rem;
        }

        li h3 a {
            text-decoration: none;
            color: #007bff;
        }

        li h3 a:hover {
            text-decoration: underline;
        }

        li p {
            margin: 0.5rem 0;
            color: #555;
        }

        li a {
            color: #007bff;
            text-decoration: none;
            font-weight: bold;
        }

        li a:hover {
            text-decoration: underline;
        }

        button {
            display: block;
            margin: 2rem auto;
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 0.8rem 1.5rem;
            font-size: 1rem;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <h1>Welcome, <%= user %>!</h1>
    <h2>All Posts</h2>
    <ul>
        <% posts.forEach(post => { %>
            <li>
                <h3><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
                <p><%= post.content %></p>
                <p>Posted on <%= new Date(post.created_at).toLocaleString() %></p>
                <a href="/user/<%= post.user_id %>"><%= post.username %></a>
            </li>
        <% }) %>
    </ul>

    <button onclick="location.href='/posts/new'">New Post</button>
</body>
</html>