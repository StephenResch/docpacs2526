<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <button onclick="location.href='/'">Back to Home</button>
    <form action="<%= post ? '/updatePost' : '/createPost' %>" method="POST">
        <% if (post) { %>
            <input type="hidden" name="post_id" value="<%= post.id %>">
            <% } %>
                <label for="title">Job Title:</label><br>
                <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required><br><br>
                <label for="description">Job Description:</label><br>
                <textarea id="description" name="description"
                    required><%= post ? post.description : '' %></textarea><br><br>
                <button type="submit">
                    <%= post ? 'Update Post' : 'Create Post' %>
                </button>
    </form>
</body>

</html>