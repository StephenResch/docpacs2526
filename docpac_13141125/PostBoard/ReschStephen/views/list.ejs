<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <button onclick="location.href='/'">Back to Home</button>
    <h1>
        <%= pageTitle %>
    </h1>
    <ul>
        <% posts.forEach(function(post) { %>
            <li>
                <h2>
                    <%= post.title %>
                </h2>
                <p>
                    <%= post.description %>
                </p>
                <p><a href="/user/<%= post.author %>/posts">
                        <%= post.author %>
                    </a></p>
                <p>
                    <%= post.timestamp %>
                </p>
                <div>
                    <% if (user===post.author) { %>
                        <form action="/editPost" method="GET" style="display: inline;">
                            <input type="hidden" name="post_id" value="<%= post.id %>">
                            <button type="submit">Edit Post</button>
                        </form>
                        <form action="/deletePost" method="POST" style="display: inline;"
                            onsubmit="return confirm('Are you sure you want to delete this post?');">
                            <input type="hidden" name="post_id" value="<%= post.id %>">
                            <button type="submit">Delete Post</button>
                        </form>
                        <% } %>

                            <div>
                                <h4>Comments:</h4>
                                <% if (post.comments && post.comments.length> 0) { %>
                                    <% post.comments.forEach(function(comment) { %>
                                        <div
                                            style="margin-left: 20px; border-left: 2px solid #ccc; padding-left: 10px; margin-bottom: 10px;">
                                            <p><strong>
                                                    <%= comment.author %>:
                                                </strong>
                                                <%= comment.content %>
                                            </p>
                                            <small>
                                                <%= comment.timestamp %>
                                            </small>
                                            <% if (user===post.author) { %>
                                                <form action="/deleteComment" method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                                    <input type="hidden" name="comment_id" value="<%= comment.id %>">
                                                    <input type="hidden" name="comment_author" value="<%= user %>">
                                                    <button type="submit">Delete Comment</button>
                                                </form>
                                                <% } %>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <p><em>No comments yet.</em></p>
                                                <% } %>

                            </div>

                            <div>
                                <h5>Add a comment:</h5>
                                <form action="/addComment" method="POST">
                                    <input type="hidden" name="post_id" value="<%= post.id %>">
                                    <textarea name="content" placeholder="Write your comment here..."
                                        required></textarea><br>
                                    <button type="submit">Post Comment</button>
                                </form>

                            </div>
            </li>
            <% }); %>
    </ul>
</body>

</html>