<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Comment</title>
</head>
<body>
    <h2>Edit Comment</h2>
    
    <form action="/editcomment" method="POST">
        <input type="hidden" name="commentid" value="<%= comment.commentid %>">
        
        <label for="content">Comment:</label><br>
        <textarea id="content" name="content" rows="4" style="width: 400px; padding: 5px;" required><%= comment.content %></textarea><br><br>
        
        <button type="submit" style="background-color: green; color: white; padding: 10px;">Save Changes</button>
        <a href="/theboard">
            <button type="button" style="background-color: gray; color: white; padding: 10px;">Cancel</button>
        </a>
    </form>
</body>
</html>