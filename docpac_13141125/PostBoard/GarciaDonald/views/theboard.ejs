<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Board</title>
</head>
<style>
    body {
        font-family: comic-sans-ms, sans-serif;
        margin: 20px;
    }
    ul {
        list-style-type: none;
        padding: 0;
    }
    li {
        background-color: #f4f4f4;
        margin: 5px 0;
        padding: 10px;
        border-radius: 5px;
    }
</style>
<body>
    JOBS:
<ul>
    <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
        <% jobs.forEach(function(job) { %>
            <!-- Display the job -->
            <li>
                <strong><%= job.title %></strong> - <%= job.description %>
                <br><small>Posted by: <a href="/profile/<%= job.username %>"><%= job.username %></a> on <%= job.created_at %></small>

                <!-- Show edit/delete buttons only if current user owns this post -->
                <p>Debug: job.username = '<%= job.username %>' | currentUser = '<%= currentUser %>'</p>
                <% if (job.username === currentUser) { %>
                    <div style="margin-top: 5px;">
                        <a href="/editpost/<%= job.postid %>">
                            <button style="background-color: blue; color: white; margin-right: 5px;">Edit</button>
                        </a>
                        <a href="/deletepost/<%= job.postid %>">
                            <button style="background-color: red; color: white;">Delete</button>
                        </a>
                    </div>
                <% } %>
                <!-- Display comments for this job -->
                <% if (job.comments && job.comments.length > 0) { %>
                    <% job.comments.forEach(function(comment) { %>
                        <div style="margin-left: 20px; padding: 5px; font-size: smaller;">
                            <%= comment.content %>
                            <br><small>By: <a href="/profile/<%= comment.username %>"><%= comment.username %></a> on <%= comment.created_at %></small>
                            
                            <!-- Show edit/delete buttons only if current user owns this comment -->
                            <% if (comment.username === currentUser) { %>
                                <div style="margin-top: 5px;">
                                    <a href="/editcomment/<%= comment.commentid %>" style="margin-right: 10px;">Edit</a>
                                    <a href="/deletecomment/<%= comment.commentid %>" style="color: red;">Delete</a>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div style="margin-left: 20px; padding: 5px; font-size: smaller; color: gray;">
                        No comments yet
                    </div>
                <% } %>
                <form action="/addcomment" method="POST" style="margin-left: 20px; margin-top: 10px;">
                    <textarea name="content" placeholder="Add a comment..." rows="2" style="width: 300px;" required></textarea>
                    <input type="hidden" name="post_id" value="<%= job.postid %>">
                    <br>
                    <button type="submit" style="margin-top: 5px;">Add Comment</button>
                </form>
            </li>
        <% }); %>
    <% } else { %>
        <li>No jobs found</li>
    <% } %>

    
</ul>
    <a href="/postjob">Post a job listing</a>
    <a href="/">Go home</a>
</body>
<script>
    posts = <%- JSON.stringify(jobs) %>;
    console.log(posts);
    jobs = posts;
    console.log(jobs);
    // You can now use the 'jobs' variable in your JavaScript code
    jobs.forEach(function(job) {
        console.log("Job Title: " + job.title + ", Description: " + job.description + ", Posted by: " + job.postedBy);
    });
</script>
</html>