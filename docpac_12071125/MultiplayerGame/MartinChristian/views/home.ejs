<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Indeedbar | Home</title>
</head>
<style>
    body {
        font-family: Arial, sans-serif;
        margin-left: 10px;
        background-color: #121212;
        color: #ffffff;
    }

    #mainTitle {
        display: inline-block;
        width: 50%;
    }

    #loginInfo {
        display: inline-block;
        text-align: right;
        width: 45%;
        margin-left: 50px;
    }

    #logoutButton {
        margin-left: 10px;
        padding: 5px 10px;
        border: solid 1px #ccc;
        border-radius: 5px;
        width: 100px;
        height: 30px;
        cursor: pointer;
        background-color: #333;
        color: #ffffff;
    }
    .buttons {
        margin-top: 20px;
        padding: 10px 20px;
        border: solid 1px #ccc;
        border-radius: 5px;
        width: 150px;
        height: 40px;
        font-size: 16px;
        cursor: pointer;
        background-color: #333;
        color: #ffffff;
    }
    .link {
        color: #ffffff;
        text-decoration: underline;
        cursor: pointer;
    }
</style>

<body>
    <h1 id="mainTitle">Indeedbar.com</h1>
    <div id="loginInfo">
        Logged in as <%- user -%>
        <button onclick="window.location.href='/logout'" id="logoutButton">Logout</button>
    </div>
    <h2>Welcome, <a class='link' href='/profile/<%- user -%>'><%- user -%></a></h2>
    <button class="buttons" onclick="window.location.href='/create'">Create Post</button>
    <button class="buttons" onclick="window.location.href='/view'">View Posts</button>
</body>
</html>