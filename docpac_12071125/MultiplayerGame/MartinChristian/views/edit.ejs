<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Indeedbar | Edit Post</title>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
    </script>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin-left: 10px;
            background-color: #121212;
            color: #ffffff;
        }
        #mainTitle {
            display: inline-block;
            width: 50%;
        }
        #loginInfo {
            display: inline-block;
            text-align: right;
            width: 45%;
            margin-left: 50px;
        }
        #logoutButton {
            margin-left: 10px;
            padding: 5px 10px;
            border: solid 1px #ccc;
            border-radius: 5px;
            width: 100px;
            height: 30px;
            cursor: pointer;
            background-color: #333;
            color: #ffffff;
        }
        .inputFields {
            margin-top: 10px;
            margin-bottom: 10px;
            padding: 5px;
            border: solid 1px #ccc;
            border-radius: 5px;
            background-color: #222;
            color: #ffffff;
        }
        #jobTitle {
            width: 450px;
            height: 30px;
            font-size: 16px;
        }
        #description {
            width: 1500px;
            height: 300px;
            font-size: 16px;
        }
        #company {
            width: 450px;
            height: 30px;
            font-size: 16px;
        }
        #submitButton {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            background-color: #333;
            color: #ffffff;
        }
        #backButton {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            margin-left: 10px;
            background-color: #333;
            color: #ffffff;
        }
    </style>
</head>

<body>
    <h1 id="mainTitle">Indeedbar.com</h1>
    <div id="loginInfo">
        Logged in as <%- user -%>
            <button onclick="window.location.href='/logout'" id="logoutButton">Logout</button>
    </div>
    <div id="postForm">
        <h2>Edit Post:</h2>
        <form id="formEdit" action="/submit" method="POST">
            <input class="inputFields" type="text" id="jobTitle" name="jobTitle" required placeholder="Job Title">
            <input class="inputFields" type="text" id="company" name="company" placeholder="Company Name" required>
            <br>
            <input class="inputFields" type="text" id="description" name="description" placeholder="Job Description" required>
            <br>
            <button type="submit" id="submitButton">Submit</button><button id="backButton" onclick="window.location.href='/view'">Back</button>
        </form>
</body>
<script>
    const posts = JSON.parse('<%- JSON.stringify(posts) %>');
    const container = document.getElementById('listingsContainer');
    const postId = window.location.pathname.split('/').pop();
    console.log(postId);
    posts.reverse();

    document.addEventListener('DOMContentLoaded', () => {
        const post = posts.find(p => p.id == postId);
        if (post) {
            document.getElementById('jobTitle').value = post.title;
            document.getElementById('company').value = post.company;
            document.getElementById('description').value = post.description;
        }
    });

    const formEdit = document.getElementById('formEdit');
    formEdit.addEventListener('submit', (e) => {
        e.preventDefault();
        const updatedPost = {
            id: parseInt(postId),
            title: document.getElementById('jobTitle').value,
            company: document.getElementById('company').value,
            description: document.getElementById('description').value
        };
        console.log(updatedPost);
        socket.emit('editSubmit', updatedPost);
        window.location.href = '/view';
    });

</script>
</html>