<%- include('partials/header') %>
<link rel="stylesheet" href="../css/profile.css">
<main>
    <div class="profile-container">
        <!-- Left side - User info and upload form -->
        <div class="profile-left">
            <h2>User Profile</h2>
            
            <!-- Success/Error messages -->
            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                <div class="alert alert-success"><%= successMessage %></div>
            <% } %>
            
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="alert alert-error"><%= errorMessage %></div>
            <% } %>

            <!-- Display user information -->
            <div class="user-info">
                <h3>Your Information</h3>
                <p><strong>Username:</strong> <%= user.username %></p>
                <p><strong>User ID:</strong> <%= user.id %></p>
                <% if (user.email) { %>
                    <p><strong>Email:</strong> <%= user.email %></p>
                <% } %>
                <% if (user.formbarId) { %>
                    <p><strong>Formbar ID:</strong> <%= user.formbarId %></p>
                <% } %>
            </div>

            <!-- File Upload Form -->
            <div class="upload-section">
                <h3>Update Profile Picture</h3>
                <form action="/upload" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="file">Choose image file:</label>
                        <input type="file" id="file" name="file" accept=".jpg,.jpeg,.png,.gif" required>
                        <small style="color: #666;">Maximum file size: 2MB. Supported formats: JPG, PNG, GIF</small>
                    </div>
                    <button type="submit" class="btn btn-success">Upload Profile Picture</button>
                </form>
            </div>

            <!-- Navigation -->
            <div style="margin-top: 30px;">
                <a href="/" class="btn">Back to Home</a>
                <a href="/socket" class="btn">Socket.IO Demo</a>
                <a href="/logout" class="btn btn-danger">Logout</a>
            </div>
        </div>

        <!-- Right side - Profile picture -->
        <div class="profile-right">
            <h3>Profile Picture</h3>
            <% if (profilePicture) { %>
                <img src="/uploads/<%= profilePicture %>" alt="Profile Picture" class="profile-picture">
            <% } else { %>
                <div class="profile-picture-placeholder">
                    No profile picture<br>Upload one!
                </div>
            <% } %>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
