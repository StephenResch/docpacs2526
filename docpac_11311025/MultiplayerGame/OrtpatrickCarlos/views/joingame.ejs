<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join Game</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f9;
            margin: 0;
            padding: 0;
        }

        h1 {
            color: #333;
            margin-top: 50px;
        }

        button, input[type="text"] {
            padding: 10px 20px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
            margin: 10px;
        }

        button {
            background-color: #007bff;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background-color: #0056b3;
        }

        button:active {
            background-color: #003f7f;
        }

        input[type="text"] {
            width: 200px;
        }

        form {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <h1>Join a Game</h1>
    <button onclick="location.href='/joinRandomGame'">Join Random Game</button>
    <form action='joinGameCode'>
        <input type="text" name="code" maxlength='4' placeholder="Enter Game ID" required>
        <button type="submit">Join Game</button>
    </form>
</body>
</html>