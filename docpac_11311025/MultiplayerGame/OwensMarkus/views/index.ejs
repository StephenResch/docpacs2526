<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wideojuegamos</title>

</head>
<body>
    <h1>hallo!!!, <%= user %>!</h1>
    <br>
<div>
    <img src="data:image/jpeg;base64," 
    id="player1icon" height="200" width="200">
    <p>This is player one!!!</p>
</div>
<div>
    <img src="data:image/jpeg;base64,"
    id="player2icon" height="200" width="200">
    <p>This is player two!!!</p>
    <button type="submit" id="startBtn">Start Game timer</button>
    <button type="button" id="resetBtn">Reset Game timer</button>
</div>
<form action="/startGame" method="POST">
    <h2 id="xValue"></h2>
    <h3 id="yValue"></h3>
    <h4 id="pointsValue"></h4>
    <button type="button" id="stopBtn">Stop Game timer</button>
    <div>Timer:<span id="display">0 </span>seconds</div>
    <canvas id="canBox" height="800" width="600" style="border:1px solid #614646;"></canvas>
    <script src="/socket.io/socket.io.js"></script>
    <script>
            window.focus();
            document.body.focus();

            const socket = io();
            var can = document.getElementById("canBox");
            var ctx = can.getContext("2d");
            let x=0;
            let p2x=500;
            let y=0;
            let p2y=0;
            const w=50;
            const h=50;
            let keyVal=0;
            let turn = 1;
            let timer = 0;
            let timerInterval;
            let points = 0;
            let points2 = 0;
            const imgp2= document.createElement('img');
            const display = document.getElementById('display');
            const startBtn = document.getElementById('startBtn');
            const stopBtn = document.getElementById('stopBtn');
            const resetBtn = document.getElementById('resetBtn');
            imgp2.src="data:image/jpeg;base64,";
            const imgp1= document.createElement('img');
            imgp1.src="data:image/jpeg;base64,";
            player=prompt("Enter player1 or player2 (no spaces or caps and only 2 players or it dosn't work ps timer lasts for 300 seconds)");
            
            document.addEventListener('keydown', function(event) {
                console.log('keydown event detected:', event.key);
                console.log("It's "+turn+"'s turn!")
                
                if (timer<300){
                    
                if (player=="player1" && turn==1) {
                    if(event.key=="ArrowUp"){
                        keyVal=1
                        y -= 10
                        turn=0
                        console.log(y)
                        if(y<0){
                            y=0
                        }
                    }
                    else if(event.key=="ArrowDown"){
                        keyVal=2
                        y += 10
                        turn=0
                        console.log(y)
                        if(y + h > canBox.height){
                            y=canBox.height - h
                        }
                        
                    }
                    else if(event.key=="ArrowLeft"){
                        keyVal=3
                        x -= 10
                        turn=0
                        console.log(x)
                        if(x<0){
                            x=0
                        }
                    }
                    else if(event.key=="ArrowRight"){
                        keyVal=4
                        x += 10
                        turn=0
                        console.log(x)
                        if(x + w > canBox.width){
                            x = canBox.width - w
                        }
                    }
                    else{
                         console.log(`${event.key} is not an arrow key!`);
                    }}
                if (player=="player2" && turn==0) {
                    if(event.key=="ArrowUp"){
                        keyVal=1
                        p2y -= 10
                        console.log(p2y)
                        turn= 1
                        if(p2y<0){
                            p2y=0
                        }
                    }
                    else if(event.key=="ArrowDown"){
                        keyVal=2
                        p2y += 10
                        console.log(p2y)
                        turn=1
                        if(p2y + h > canBox.height){
                            p2y=canBox.height - h
                        }
                        
                    }
                    else if(event.key=="ArrowLeft"){
                        keyVal=3
                        p2x -= 10
                        console.log(p2x)
                        turn=1
                        if(p2x<0){
                            p2x=0
                        }
                    }
                    else if(event.key=="ArrowRight"){
                        keyVal=4
                        p2x += 10
                        console.log(p2x)
                        turn=1
                        if(p2x + w > canBox.width){
                            p2x = canBox.width - w
                        }
                    }
                    else{
                         console.log(`${event.key} is not an arrow key!`);
                    }}
                if (x==p2x && y==p2y){
                    alert("you fused! Go back home! points+1")
                    x=0
                    y=0
                    p2x=500
                    p2y=0
                    if (player=="player1" && turn==0){
                    points+=1}
                    if (player=="player2"&& turn==1){
                        points2+=1
                    }
                };}
                else{
                    alert("Time's up! No more moves allowed." + " again your Final Score - Player 1: " + points + ", Player 2: " + points2);
                    points=0
                    points2=0
                }
                console.log(x,p2x,y,p2y,turn)
                let data={
                    p1x: x , p1y: y ,
                    p2xd: p2x , p2yd: p2y,turncur: turn,
                    clock:timer,
                    p1points:points,
                    p2points:points2
                };
                let sendedata=JSON.stringify(data)
                socket.emit('userUpdate',sendedata)
                console.log("userUpdatefire")
                requestAnimationFrame(movement);
                });
            socket.on('serverUpdate',function(data){
                console.log("serverUpdatefire")
                    let receiveddata=JSON.parse(data)
                    x=receiveddata.p1x
                    y=receiveddata.p1y
                    p2x=receiveddata.p2xd
                    p2y=receiveddata.p2yd
                    turn=receiveddata.turncur
                    timer=receiveddata.clock
                    points=receiveddata.p1points
                    points2=receiveddata.p2points})
            socket.on('serverMessagetime',function(rtimer){
                console.log("timefire")
                console.log("rtimer received:",rtimer)
                    let prestime=JSON.parse(rtimer)
                    timer=prestime
                updateDisplay()})
                
                function updateDisplay() {
                display.textContent = timer;}

                function startTimer() {
                if (!timerInterval) { 
                timerInterval = setInterval(() => {
                let rotimer=JSON.stringify(timer)
                console.log("timer before increment:",timer)
                socket.emit('timeUpdate',rotimer)
                console.log("timeUpdatefire",timer)
                updateDisplay();
                if (timer==300){
                alert("Time's up!"  + " Final Score - Player 1: " + points + ", Player 2: " + points2)
                clearInterval(timerInterval);
                timerInterval = null; 
                }
                }, 1000);}}

                function stopTimer() {
                clearInterval(timerInterval);
                timerInterval = null; 

                }

                function resetTimer() {
                stopTimer();
                timer = 0;
                updateDisplay();
                }
                function movement(){
                console.log("movementfire")
                ctx.drawImage(imgp1,x,y,w,h)
                ctx.drawImage(imgp2,p2x,p2y,w,h)
                
                ctx.clearRect(0, 0, can.width, can.height)
                ctx.drawImage(imgp1,x,y,w,h)
                ctx.drawImage(imgp2,p2x,p2y,w,h)
                
                xValue.innerHTML="P1 X value:"+x +" P2 X value:"+p2x
                yValue.innerHTML="P1 Y value:"+y + " P2 Y value:"+p2y
                pointsValue.innerHTML="P1 Points:"+points + " P2 Points:"+points2
                updateDisplay()
               }
               startBtn.addEventListener('click', startTimer);{}
               stopBtn.addEventListener('click', stopTimer);
               resetBtn.addEventListener('click', resetTimer);

            
        </script>
</body>

</html>