<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tic Tac Toe User</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f3defa;
      text-align: center;
      padding: 20px;
    }
    input[type="text"] {
      padding: 10px;
      width: 200px;
      
    }
    input[type="submit"] {
      padding: 10px 20px;
      background-color: #20082e;
      color: white;

    }
  
  </style>
</head>
<body>
  <h1>What's your username?</h1>
  <form action="/game" method="get">
    <input name="user" type="text" placeholder="username" required />
    <input type="submit" value="play" />
  </form>
  <a href="/signup">sign up!</a>
</body>
</html>
